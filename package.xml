<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>endoscope_device</name>
  <version>0.1.0</version>
  <description>Portable V4L2 endoscope lifecycle camera for ROS 2 Humble</description>
  <maintainer email="wanglei@example.com">wanglei</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rmw_fastrtps_cpp</exec_depend>
